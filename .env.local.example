# Turso Database Configuration
# Get these from https://turso.tech
#
# No Turso account? Point the URL at a local SQLite file instead and build it
# with `pnpm db:setup` — the token is ignored for file: URLs:
#   TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=your_turso_auth_token_here
TURSO_DATABASE_URL=libsql://your_database_url

# Vercel Deployment
# OIDC token for deploying to Vercel
VERCEL_OIDC_TOKEN=your_vercel_oidc_token

# Navasan API (Currency Exchange Rates)
# Sign up at https://navasan.tech for API access
NAVASAN_API_KEY=your_navasan_api_key

# Resend (Transactional Email)
# Sign up at https://resend.com and verify the kharji.app sender domain.
# Use a "restricted" key during testing — it can only send to verified addresses.
RESEND_API_KEY=re_your_resend_api_key

# Cron Secret
# Random string used to authenticate the Vercel Cron → /api/cron/reports and /api/cron/backup calls.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret

# App URL (used for absolute links inside emails — unsubscribe, web-view, etc.)
APP_URL=http://localhost:3000

# Better Auth
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Better Auth Infrastructure (dash.better-auth.com) — dashboard/audit logs
BETTER_AUTH_API_KEY=your_better_auth_infra_api_key

# Sentry (Error Monitoring)
# Provided automatically on Vercel by the Sentry marketplace integration.
# For local dev, copy values from the Vercel integration page (or run `vercel env pull`).
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug

# Backblaze B2 (Database Backups)
# Application key created in the B2 console — keyID + the secret applicationKey (shown once at creation).
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=kharji
B2_ENDPOINT=s3.ca-east-006.backblazeb2.com

PORT=3001