{
  "name": "kharji",
  "version": "1.6.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erfanansari/kharji.git"
  },
  "scripts": {
    "dev": "rm -f public/sw.js public/sw.js.map && next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky",
    "migrate": "tsx src/core/database/migrate.ts",
    "email:dev": "email dev --dir src/emails --port 3001",
    "db:seed": "tsx src/core/database/seed-user.ts",
    "db:test": "tsx src/core/database/test-connection.ts",
    "db:seed-demo": "tsx src/core/database/seed-demo.ts",
    "db:backup": "tsx src/core/database/run-backup.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "release": "release-it",
    "release:patch": "release-it --increment=patch",
    "release:minor": "release-it --increment=minor",
    "release:major": "release-it --increment=major",
    "release:dry": "release-it --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@better-auth/infra": "^0.3.5",
    "@hookform/resolvers": "^5.4.0",
    "@libsql/client": "^0.17.3",
    "@libsql/kysely-libsql": "^0.4.1",
    "@number-flow/react": "^0.6.1",
    "@persian-tools/persian-tools": "^4.0.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sentry/nextjs": "^10.64.0",
    "@serwist/next": "^9.5.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.6.23",
    "date-fns": "^4.2.1",
    "jalaali-js": "^2.0.0",
    "kbar": "0.1.0-beta.48",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "react": "19.2.6",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.81.0",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@react-email/ui": "6.5.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@serwist/cli": "^9.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react-email": "^6.5.0",
    "release-it": "^21.0.0",
    "serwist": "^9.5.11",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.24.0"
}
